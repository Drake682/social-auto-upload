FROM mcr.microsoft.com/playwright/python:v1.52.0-jammy

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    FLASK_PORT=5000 \
    DISPLAY=:99

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        fluxbox \
        novnc \
        websockify \
        xauth \
        x11-utils \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "Flask[async]==3.1.1" \
    flask-cors==6.0.0 \
    SQLAlchemy==2.0.41 \
    psycopg2-binary \
    cryptography \
    boto3 \
    playwright==1.52.0 \
    requests==2.32.3 \
    PyYAML==6.0.2 \
    qrcode==8.2 \
    xhs \
    edge-tts \
    openai \
    loguru \
    patchright \
    opencv-python-headless \
    numpy \
    Pillow \
    segno

RUN playwright install --with-deps chromium

COPY . .

RUN if [ ! -f conf.py ] && [ -f conf.example.py ]; then cp conf.example.py conf.py; fi \
    && mkdir -p /app/videoFile /app/cookiesFile /app/error_logs \
    && chmod +x /app/uploader/entrypoint.sh

EXPOSE 5000 8080

ENTRYPOINT ["/app/uploader/entrypoint.sh"]
